{
  "name": "docxkeun",
  "version": "0.1.2",
  "description": "Read, render, edit and convert .docx files in the browser: a DOCX viewer, editor and DOCX-to-PDF converter with zero runtime dependencies.",
  "author": "Kevin Jeremia (https://github.com/kevinkjs)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kevinkjs/docxkeun.git"
  },
  "homepage": "https://kevinkjs.github.io/docxkeun/",
  "bugs": {
    "url": "https://github.com/kevinkjs/docxkeun/issues"
  },
  "keywords": [
    "docx",
    "docx-viewer",
    "docx-editor",
    "docx-to-pdf",
    "docx-parser",
    "word",
    "word-to-pdf",
    "ms-word",
    "ooxml",
    "office",
    "pdf",
    "viewer",
    "editor",
    "document-viewer",
    "wysiwyg",
    "comments",
    "document-protection",
    "encryption",
    "browser",
    "react",
    "svg",
    "typescript",
    "zero-dependency"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/security/index.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./viewer": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf/index.d.ts",
      "import": "./dist/pdf/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js"
    },
    "./fonts": {
      "types": "./dist/fonts/index.d.ts",
      "import": "./dist/fonts/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "build:site": "vite build",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.2"
}
