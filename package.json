{
  "name": "docxkit",
  "version": "0.1.0",
  "private": true,
  "description": "Read, render, edit and convert .docx files in the browser, with zero runtime dependencies.",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": [
    "./dist/security/index.js"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./editor": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./viewer": {
      "types": "./dist/render/index.d.ts",
      "import": "./dist/render/index.js"
    },
    "./pdf": {
      "types": "./dist/pdf/index.d.ts",
      "import": "./dist/pdf/index.js"
    },
    "./security": {
      "types": "./dist/security/index.d.ts",
      "import": "./dist/security/index.js"
    },
    "./fonts": {
      "types": "./dist/fonts/index.d.ts",
      "import": "./dist/fonts/index.js"
    },
    "./layout": {
      "types": "./dist/layout/index.d.ts",
      "import": "./dist/layout/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "prepublishOnly": "pnpm test && pnpm build"
  },
  "engines": {
    "node": ">=20.12"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "docx",
    "word",
    "ooxml",
    "pdf",
    "viewer",
    "editor",
    "comments",
    "encryption"
  ]
}
